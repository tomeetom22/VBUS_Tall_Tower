'CR3000
'Created by Short Cut (4.4)

'Declare Variables and Units
Public BattV
Public PTemp_C
Public DiffVolt
Public Ozone
Public FileWritten As Boolean
Public LastFile As String * 64

Units BattV=Volts
Units PTemp_C=Deg C
Units DiffVolt=mV
Units Ozone=ppbv

'Define Data Tables
DataTable(Ozone_PPM,True,-1)
	DataInterval(0,2,Sec,10)
	TableFile("CRD:Ozone",64,-1,1000,0,Sec,FileWritten,LastFile)
	Sample(1,DiffVolt,FP2)
	Sample(1,PTemp_C,FP2)
	Sample(1,Ozone,FP2)
EndTable

'Main Program
BeginProg
	'Main Scan
	Scan(1,Sec,1,0)
		'Default CR3000 Datalogger Battery Voltage measurement 'BattV'
		Battery(BattV)
		'Default CR3000 Datalogger Wiring Panel Temperature measurement 'PTemp_C'
		PanelTemp(PTemp_C,_60Hz)
		'Generic Differential Voltage measurements 'DiffVolt'
		VoltDiff(DiffVolt,1,mV5000,6,True,0,_60Hz,1,0)
		'Compute Ozone ppbv, option to add mV differential when calibrated'
		Ozone = (DiffVolt-0)*0.1
		'Call Data Tables and Store Data
		CallTable Ozone_PPM
	NextScan
EndProg
